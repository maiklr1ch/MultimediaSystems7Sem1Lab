{
  "name": "media-player-lab2",
  "productName": "Медіапрогравач",
  "version": "1.0.0",
  "description": "Лабораторна робота №2: desktop-застосунок для відтворення аудіо та відео (Electron + React + TypeScript)",
  "main": "./out/main/index.js",
  "author": "Danya",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "build": "npm run typecheck && electron-vite build",
    "start": "electron-vite preview",
    "test:e2e": "npm run build && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tests/e2e.mjs",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:mac": "npm run build && electron-builder --mac",
    "test:unit": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/range.test.ts",
    "serve:fixtures": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tests/fixtures-server.mjs"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "hls.js": "^1.7.4",
    "lucide-react": "^1.66.0",
    "playwright": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "engines": {
    "node": ">=22.18"
  }
}
